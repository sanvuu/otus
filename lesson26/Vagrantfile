# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/jammy64"

  # =========================================================================
  # BACKUP SERVER (192.168.11.160)
  # =========================================================================
  config.vm.define "backup_server" do |backup|
    backup.vm.hostname = "backup-server"
    backup.vm.network "private_network", ip: "192.168.11.160"
    
    backup.vm.provider "virtualbox" do |v|
      v.memory = 2048
      v.cpus = 2
      
      disk_path = File.join(Dir.pwd, 'backup_storage.vdi')
      unless File.exist?(disk_path)
        v.customize ["createmedium", "--filename", disk_path, "--size", 2048, "--variant", "Standard"]
      end
      
      # Подключаем к существующему SCSI контроллеру бокса
      v.customize ["storageattach", :id, "--storagectl", "SCSI", "--port", "2", "--device", "0", "--type", "hdd", "--medium", disk_path]
    end
  end

  # =========================================================================
  # CLIENT (192.168.11.150)
  # =========================================================================
  config.vm.define "client" do |client|
    client.vm.hostname = "client"
    client.vm.network "private_network", ip: "192.168.11.150"
    
    client.vm.provider "virtualbox" do |v|
      v.memory = 2048
      v.cpus = 2
    end

    client.vm.synced_folder ".", "/vagrant", disabled: false

    # Shell-provisioner для корректного multi-node запуска плейбука
    client.vm.provision "shell", inline: <<-SHELL
      echo "=== [1/2] Installing Ansible inside Client Machine ==="
      apt-get update && apt-get install -y ansible

      echo "=== [2/2] Running Multi-Node Playbook ==="
      cd /vagrant
      ansible-playbook -i ansible/inventory.ini ansible/playbook.yml
    SHELL
  end
end
