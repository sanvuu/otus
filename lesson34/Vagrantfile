Vagrant.configure("2") do |config|
  # Базовый образ
  config.vm.box = "bento/ubuntu-24.04"

  # Настройки провайдера Libvirt (по 2 ГБ ОЗУ и 2 vCPU на каждую ВМ)
  config.vm.provider :libvirt do |libvirt|
    libvirt.memory = 2048
    libvirt.cpus = 2
  end

  # Отключаем стандартную синхронизацию папок, чтобы не требовать NFS/rsync (опционально)
  config.vm.synced_folder ".", "/vagrant", disabled: true

  # Первая ВМ (Подсеть 192.168.10.0/24)
  config.vm.define "node1" do |node1|
    node1.vm.hostname = "server.local"
    node1.vm.network "private_network",
      ip: "192.168.56.10",
      libvirt__network_name: "net_subnet_1",
      libvirt__forward_mode: "nat"
  end

  # Вторая ВМ (Подсеть 192.168.20.0/24)
  config.vm.define "node2" do |node2|
    node2.vm.hostname = "client.local"
    node2.vm.network "private_network",
      ip: "192.168.56.20",
      libvirt__network_name: "net_subnet_1",
      libvirt__forward_mode: "nat"
  end
end
